# Variables de entorno de Handless; copiar a .env SOLO para uso local.
# En Render/Neon, definir secretos en la configuración del servicio (no en GitHub).
DATABASE_URL=sqlite:///./handless-local.db
SESSION_SECRET=
DEMO_PASSWORD=
# Sólo activar para demostraciones con DATOS FICTICIOS y roles compartidos.
PUBLIC_DEMO_ENABLED=false
